 RowBox[{
  RowBox[{"DefTensor", "[", 
   RowBox[{
    RowBox[{"Y", "[", "]"}], ",", "M", ",", 
    RowBox[{"PrintAs", "\[Rule]", "\"\<Y\>\""}]}], "]"}], ";"}]], "Input",
