af78f3339ec9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefTensor", "[", 
   RowBox[{
    RowBox[{"vecAx", "[", 
     RowBox[{"-", "a"}], "]"}], ",", "M", ",", 
    RowBox[{
    "PrintAs", "\[Rule]", "\"\<\!\(\*SuperscriptBox[\(S\), \(lm\)]\)\>\""}]}],
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefTensor", "[", 
   RowBox[{
    RowBox[{"vecPol", "[", 
     RowBox[{"-", "a"}], "]"}], ",", "M", ",", 
    RowBox[{
    "PrintAs", "\[Rule]", "\"\<\!\(\*SuperscriptBox[\(Y\), \(lm\)]\)\>\""}]}],
    "]"}], ";"}]}], "Input",
