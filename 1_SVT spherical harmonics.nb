Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"epsilonBG", " ", "=", " ", 
  RowBox[{"CTensor", "[", 
   RowBox[{
    RowBox[{"{", "\n", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "[", "]"}], "]"}]}], "}"}], ",", "\n", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "[", "]"}], "]"}]}], ",", "0"}], "}"}]}], "}"}],
     ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "B"}], ",", 
      RowBox[{"-", "B"}]}], "}"}]}], "]"}]}]], "Input",
