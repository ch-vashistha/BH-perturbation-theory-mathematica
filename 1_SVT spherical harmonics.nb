Cell["Define the spherical harmonic function, Ylm", "Text",
 CellChangeTimes->{{3.9888475096311703`*^9, 
  3.9888475353325233`*^9}},ExpressionUUID->"e104b8c4-6745-497e-b0ce-\
152c5e869967"],

Cell[BoxData[
 RowBox[{"DefScalarFunction", "[", "Ylm", "]"}]], "Input",
 CellChangeTimes->{{3.988847462767846*^9, 3.988847499768332*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"6e856b1f-1954-49f7-bded-427dfa73cff2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ComponentRulesSphere", " ", "=", " ", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{
       RowBox[{"-", "a_Symbol"}], ",", " ", 
       RowBox[{"-", "b_Symbol"}]}], "]"}], " ", ":>", " ", 
     RowBox[{"bg", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", " ", 
       RowBox[{"-", "b"}]}], "]"}]}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"a_Symbol", ",", " ", "b_Symbol"}], "]"}], " ", ":>", " ", 
     RowBox[{"invbg", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], ",", "\n", "  ", 
