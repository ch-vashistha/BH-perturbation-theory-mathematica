   3.9887815458259106`*^9}, {3.9887815759421253`*^9, 3.98878162230765*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"4130640c-9d90-4297-9eae-50d528e9f1b2"],

Cell["\<\

Define rules to make substitutions: \
\>", "Text",
 CellChangeTimes->{{3.989308686585489*^9, 
  3.989308703095603*^9}},ExpressionUUID->"24599a43-ad20-45bc-9b4e-\
ed654475eeb0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vecPolRule", " ", "=", " ", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"vecPol", "[", 
        RowBox[{"-", "a"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"CD", "[", 
         RowBox[{"-", "a"}], "]"}], "@", 
        RowBox[{"Y", "[", "]"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "\[Rule]", "All"}], ",", 
     RowBox[{"ContractMetrics", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vecAxRule", " ", "=", " ", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"vecAx", "[", 
        RowBox[{"-", "a"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"epsilong", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", "c"}], "]"}], "*", 
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{"-", "c"}], "]"}], "@", 
         RowBox[{"Y", "[", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "\[Rule]", "All"}], ",", 
     RowBox[{"ContractMetrics", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.988785013054977*^9, 3.9887850301548295`*^9}, {
   3.9887853391646957`*^9, 3.988785359094584*^9}, 3.9887854123945436`*^9, {
   3.988785517194558*^9, 3.988785535694507*^9}, {3.988785572594966*^9, 
   3.988785664674014*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"047ad65c-d5d6-4002-9cb0-b03f37718dc1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tensorPolRule", " ", "=", " ", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tensorPol", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{"-", "a"}], "]"}], "@", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "b"}], "]"}], "@", 
          RowBox[{"Y", "[", "]"}]}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"l", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}], "/", "2"}]}], ")"}], " ", "*", 
         " ", 
         RowBox[{"g", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", 
           RowBox[{"-", "b"}]}], "]"}], "*", 
         RowBox[{"Y", "[", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "\[Rule]", "All"}], ",", 
     RowBox[{"ContractMetrics", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tensorAxRule", " ", "=", " ", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tensorAx", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"CD", "[", 
            RowBox[{"-", "b"}], "]"}], "@", 
           RowBox[{"vecAx", "[", 
            RowBox[{"-", "a"}], "]"}]}], "+", " ", 
          RowBox[{
           RowBox[{"CD", "[", 
            RowBox[{"-", "a"}], "]"}], "@", 
           RowBox[{"vecAx", "[", 
            RowBox[{"-", "b"}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "\[Rule]", "All"}], ",", 
     RowBox[{"ContractMetrics", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.988785668054141*^9, 3.9887856803345194`*^9}, {
  3.9887858747041273`*^9, 3.988785882113762*^9}, {3.988785923614052*^9, 
  3.988785949753826*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"85006e5c-f1f3-42f3-8e72-971f23a7df6d"]
}, Open  ]],

