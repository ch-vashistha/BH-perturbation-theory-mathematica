        RowBox[{"phi", "[", "]"}], "]"}], "*", 
       RowBox[{
        RowBox[{"CD", "[", "a", "]"}], "[", 
        RowBox[{"phi", "[", "]"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], 
       RowBox[{"mphi", "^", "2"}], " ", "*", " ", 
       RowBox[{
        RowBox[{"phi", "[", "]"}], "^", "2"}]}]}], ")"}]}], "//", 
   RowBox[{"SeparateMetric", "[", "g", "]"}]}]}]], "Input",
