Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tortoise", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", 
        RowBox[{"0", ",", "1"}], "]"}], "[", "psi", "]"}], "[", 
      RowBox[{"t", ",", "r"}], "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"fmet", "[", "r", "]"}]}], ")"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", "1"}], "]"}], "[", "psi", "]"}], "[", 
       RowBox[{"t", ",", "rs"}], "]"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", 
        RowBox[{"0", ",", "2"}], "]"}], "[", "psi", "]"}], "[", 
      RowBox[{"t", ",", "r"}], "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{
          RowBox[{"fmet", "[", "r", "]"}], "^", "2"}]}], ")"}], " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "psi", "]"}], "[", 
        RowBox[{"t", ",", "rs"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "/", 
         RowBox[{
          RowBox[{"fmet", "[", "r", "]"}], "^", "2"}]}], ")"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"fmet", "[", "r", "]"}], ",", "r"}], "]"}], 
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "psi", "]"}], "[", 
        RowBox[{"t", ",", "rs"}], "]"}]}]}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.988955652787876*^9, 3.9889558567575526`*^9}, {
