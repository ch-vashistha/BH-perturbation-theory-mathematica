Cell["\<\
Rules for the transformation of the derivatives when moving from radial to \
tortoise coordinate. \
\>", "Text",
 CellChangeTimes->{{3.989310641316246*^9, 
  3.989310660366563*^9}},ExpressionUUID->"a92f6d7f-008a-4f01-8d74-\
815950b2edaa"],

Cell[CellGroupData[{

Cell["\<\
tortoise = {Derivative[0, 1][alm][t, r] -> (1/fmet[r]) Derivative[0, \
1][alm][t, rs], Derivative[0, 2][alm][t, r] -> (1/fmet[r]^2) Derivative[0, \
2][alm][t, rs] + (-1/fmet[r]^2) D[fmet[r], r] Derivative[0, 1][alm][t, rs],
  Derivative[2, 0][alm][t, r] -> Derivative[2, 0][alm][t, rs], alm[t, \
r]->alm[t, rs]}\
\>", "Input",
 CellChangeTimes->{{3.9890098246295695`*^9, 3.989009855011351*^9}, {
  3.989010054125287*^9, 3.989010059214048*^9}, {3.989010092576205*^9, 
