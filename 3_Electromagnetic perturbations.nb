Cell[TextData[{
 "\nConsider the even parity master function to be: ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[CapitalGamma]", "lm"], " ", "=", 
     RowBox[{
      SuperscriptBox["r", "2"], 
      SubscriptBox["b", "lm"]}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "8c749fb8-0c3a-4d6c-8d28-a9a295279650"],
 ". Slightly different choice than Berti, where ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", "lm"], "=", 
    FractionBox[
     RowBox[{
      InterpretationBox[
       StyleBox[
        SubscriptBox["b", "lm"],
        ShowAutoStyles->False,
        AutoSpacing->False],
       $CellContext`blm,
       Editable->False], " ", 
      SuperscriptBox["r", "2"]}], 
     RowBox[{
      InterpretationBox[
       StyleBox["l",
        ShowAutoStyles->False,
        AutoSpacing->False],
       $CellContext`l,
       Editable->False], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        InterpretationBox[
         StyleBox["l",
          ShowAutoStyles->False,
          AutoSpacing->False],
         $CellContext`l,
         Editable->False]}], ")"}]}]]}]}]],
  CellChangeTimes->{{3.9893743072176175`*^9, 3.989374313481835*^9}},
  ExpressionUUID->"e48e6f71-061f-48e4-b39f-3d04614f0b5c"],
