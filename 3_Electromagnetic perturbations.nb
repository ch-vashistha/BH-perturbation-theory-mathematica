Cell[TextData[{
 "It can be seen that the odd- and even-parity sectors share the same \
effective potential. \n",
 StyleBox["Consequently, vector perturbations in the Schwarzschild spacetime \
are trivially isospectral.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9893744193896575`*^9, 3.9893744606773314`*^9}, {
  3.98937449973738*^9, 3.9893745101416793`*^9}, {3.989374768057044*^9, 
