Cell[BoxData[
 RowBox[{"DefConstantSymbol", "[", 
  RowBox[{"rs", ",", " ", 
   RowBox[{
   "PrintAs", "\[Rule]", "\"\<\!\(\*SubscriptBox[\(r\), \(*\)]\)\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9889528374178843`*^9, 3.988952881185046*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"e019eb17-22b4-4341-bd97-1404a0540c33"],

Cell["\<\

Rules for the transformation of the derivatives when moving from radial to \
tortoise coordinate. \
\>", "Text",
 CellChangeTimes->{{3.989310641316246*^9, 3.989310660366563*^9}, 
   3.9893879415155096`*^9},ExpressionUUID->"720bac07-6c96-43b3-a065-\
a853318e1710"],

Cell["\<\
tortoise = {
Derivative[0, 1][Zodd][t, r] -> (1/fmet[r]) Derivative[0, 1][Zodd][t, rs], 
Derivative[0, 2][Zodd][t, r] -> (1/fmet[r]^2) Derivative[0, 2][Zodd][t, rs] + \
(-1/fmet[r]^2) D[fmet[r], r] Derivative[0, 1][Zodd][t, rs]
};\
\>", "Input",
 CellChangeTimes->{{3.9890098246295695`*^9, 3.989009855011351*^9}, {
  3.989010054125287*^9, 3.989010059214048*^9}, {3.989010092576205*^9, 
  3.9890101034931498`*^9}, {3.989010152381493*^9, 3.989010160818492*^9}, {
  3.989012825367141*^9, 3.9890128391667776`*^9}, {3.989384634906095*^9, 
  3.9893846950660563`*^9}},
 CellLabel->"In[85]:=",ExpressionUUID->"07c91ef6-16a1-4b82-b3a8-9ddb7d853ae2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"t4", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"t3", "/.", "tortoise"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"fmet", "[", "r", "]"}], "\[Rule]", 
