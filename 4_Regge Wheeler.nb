Cell[TextData[{
 "Finally to obtain the RW equation, substitute the expression for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "0"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "8c21e673-de8f-4465-afde-6f45d9e31806"],
 " derived in (",
 StyleBox["4.4.71)",
  FontWeight->"Bold"],
 " into (",
 StyleBox["4.4.70).",
  FontWeight->"Bold"],
 " This will leave one decoupled equation, purely in terms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "1"], ".", " "}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "6e90c68d-0135-4e89-9f89-fae7e1521490"]
}], "Text",
